# Public (browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push VAPID Key (Firebase Console > Project Settings > Cloud Messaging > Web configuration > Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_APP_URL=https://sunrootlearn.com
# Optional: Google Search Console HTML-tag verification code (the content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server only (Firebase Admin SDK)
FIREBASE_ADMIN_PROJECT_ID=synapta-learning
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Google Gemini AI Config (Fix Pack C: Dual Tier Quota Survival)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_TUTOR=gemini-3.1-flash-lite
GEMINI_MODEL_STRUCTURED=gemini-3.1-flash-lite
GEMINI_MODEL_LONGDOC=gemini-3.1-flash-lite
GEMINI_MODEL_BUILD=gemini-3.6-flash
GEMINI_MODEL_GRADING=gemini-3.6-flash
GEMINI_MODEL_VOICE=gemini-3.8-live
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
GEMINI_CHAIN_LIGHT=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_CHAIN_HEAVY=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.8-flash
GEMINI_MODEL_OVERFLOW=
GEMINI_RPD_LIMITS=

# Platform Admin & Token Quotas
ADMIN_EMAILS=admin@synapta.app
STUDENT_TOKEN_LIMIT=50000
TEACHER_TOKEN_LIMIT=200000

# Optional Observability & Caching
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Payments (Paystack) ---
# Secret key from the Paystack dashboard (Settings > API Keys & Webhooks). Never commit the real value.
PAYSTACK_SECRET_KEY=
# Fallback only: 1 limits everybody until an admin saves a choice at /admin/billing (Off / Test accounts only / Everyone).
# Leave empty and use the admin page instead.
BILLING_ENFORCED=
# Sprout's reading voice (the notes read aloud): a small Edge neural child voice, lifted high in pitch. No sound effect is added.
# Sprout's reading voice (the notes read aloud): a small Edge neural voice that the browser makes sound like a robot.
# Natural studio voices stay on the podcast. Default is en-US-AnaNeural (a child voice).
# SPROUT_READ_VOICE=en-US-AnaNeural

# Pictures from across the web for word pop-ups (optional). The address of a SearXNG server you run
# (https://github.com/searxng/searxng, open source metasearch, needs the json format enabled). Without it, pictures come from
# Wikipedia articles, Wikimedia Commons and Openverse only, which are all openly licensed.
# SEARXNG_URL=https://search.example.org

# OpenRouter (many models, one key). Normally set in Admin, System, AI Key & Provider; this is the alternative.
# OPENROUTER_API_KEY=sk-or-...

# ---- Added by the security hardening pass (names only, no values) ----

# SERVER ONLY. 32-byte key that encrypts provider API keys stored in Firestore (AES-256-GCM).
# Generate with: openssl rand -base64 32   (or 64 hex characters). Keep a backup: losing it makes stored keys unreadable
# (re-enter them in Admin). Without it, keys are stored unencrypted and Admin shows a warning.
# SECRETS_ENCRYPTION_KEY=

# Shared secret that cron endpoints require (Authorization: Bearer ...).
# CRON_SECRET=
# Public base URL of the site (used in links and callbacks), e.g. the production domain with https.
# APP_URL=
# Comma-separated Gemini model names to try, in order, when the admin has not configured routes.
# GEMINI_FALLBACK_CHAIN=
# Groq API key (alternative to setting it in Admin, System, AI Key & Provider).
# GROQ_API_KEY=
# Text-to-speech engine preference: auto, edge, openrouter, elevenlabs ...
# VOICE_ENGINE=
# ElevenLabs voice key (optional).
# ELEVENLABS_API_KEY=
# Web search for study research (optional; any one).
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# YouTube Data API key for video suggestions (optional).
# YOUTUBE_API_KEY=
# Google OAuth web client id for native Google sign-in (public, ends in .apps.googleusercontent.com).
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Legacy/alternate Firebase Admin variable names read by some scripts.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Set to 1 only in the Dockerfile (self-hosted standalone build). Never needed on Vercel.
# SELF_HOST=
# Set automatically by the platform (do not set by hand): NODE_ENV, VERCEL_GIT_COMMIT_SHA, NEXT_PUBLIC_BUILD_ID.
